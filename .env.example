# The password you type to open the board (only you).
APP_PASSWORD=
# A long random string — signs the login cookie. `openssl rand -hex 32`
SESSION_SECRET=
# A long random string — the kit sends boards with it. The same value goes in GAMEDEV_BOARD_TOKEN on your machine.
INGEST_TOKEN=
# Set by Vercel when a Blob store is connected (one or the other). Without either the app keeps data in .data/ (local runs).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
