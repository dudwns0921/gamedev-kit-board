{
  "engine": "web",
  "board": {
    "flow": [
      {
        "name": "Morning at the post office",
        "about": "Sort the day's letters and pick a route",
        "ids": [
          "RULE.SORT.*",
          "BAL.DAY.*"
        ],
        "assets": [
          "letter_bag"
        ]
      },
      {
        "name": "Take off",
        "about": "Hold to rise, let go to glide",
        "ids": [
          "BAL.PLANE.*",
          "INPUT.*"
        ],
        "assets": [
          "plane"
        ]
      },
      {
        "name": "Over the islands",
        "about": "Ride the wind between islands",
        "ids": [
          "BAL.WIND.*",
          "RULE.BIRD.*"
        ],
        "assets": [
          "island_small",
          "wind_loop"
        ]
      },
      {
        "name": "Drop the letters",
        "about": "Let go over a mailbox to deliver",
        "ids": [
          "RULE.DROP.*",
          "BAL.DROP.*"
        ],
        "assets": [
          "mailbox",
          "drop_ping"
        ]
      },
      {
        "name": "Dusk and the lighthouse",
        "about": "The day ends; spend the coins",
        "ids": [
          "RULE.DUSK.*",
          "BAL.SHOP.*"
        ],
        "assets": [
          "lighthouse"
        ],
        "loop": false
      }
    ],
    "service": {
      "game": "paper-courier"
    },
    "play": {
      "run": "npm run play-route -- {out}",
      "route": [
        {
          "id": "post-office",
          "stage": "Morning at the post office",
          "what": "the counter and the day's bag"
        },
        {
          "id": "take-off",
          "stage": "Take off",
          "what": "the plane leaving the first island"
        },
        {
          "id": "islands",
          "stage": "Over the islands",
          "what": "the route from above"
        },
        {
          "id": "drop",
          "stage": "Drop the letters",
          "what": "a letter over a mailbox"
        },
        {
          "id": "dusk",
          "stage": "Dusk and the lighthouse",
          "what": "the beam pointing home"
        }
      ]
    }
  }
}
